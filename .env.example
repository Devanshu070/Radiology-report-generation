# Local Groq configuration. Copy to .env and add keys there; never commit .env.
# The client rotates across configured keys in numeric order between requests.
GROQ_API_KEY=''
GROQ_API_KEY_1=''
GROQ_API_KEY_2=''
GROQ_API_KEY_3=''
GROQ_API_KEY_4=''
GROQ_API_KEY_5=''
GROQ_API_KEY_6=''
GROQ_API_KEY_7=''
GROQ_API_KEY_8=''
GROQ_API_KEY_9=''
GROQ_API_KEY_10=''
USE_GROQ=true
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
GROQ_TEMPERATURE=0
GROQ_MAX_COMPLETION_TOKENS=6000
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_HTTP_ATTEMPTS=3
GROQ_MAX_STRUCTURED_RETRIES=3
CLINICAL_DATA_ROOT=data/private/
